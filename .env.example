# Production / Railway: set DATABASE_URL to a PostgreSQL instance.
# Locally, leave it empty and `npm start` will boot an embedded PostgreSQL.

PORT=3000
NODE_ENV=development
DATABASE_URL=
PUBLIC_BASE_URL=http://localhost:3000

# Twilio WhatsApp. The webhook is POST https://<public-domain>/webhook
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Sender, for example whatsapp:+12762762210. Or set a messaging service instead.
TWILIO_WHATSAPP_NUMBER=
TWILIO_MESSAGING_SERVICE_SID=
# Optional approved Content SID (HXxxxx) with one variable, used outside the 24 hour window.
TWILIO_CONTENT_SID=
META_GRAPH_VERSION=v21.0
# Meta Embedded Signup for a broker's own WhatsApp Business app.
# The system bot keeps using Twilio. These fields are only for DIRECT_COEXISTENCE.
META_APP_ID=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
META_EMBEDDED_CONFIG_ID=

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Photos and videos. Open a Cloudinary product environment for NadlanBot,
# then paste its cloud name, API key and API secret. Files land in the nadlanbot folder.
STORAGE_PROVIDER=local
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=nadlanbot
CLOUDINARY_FOLDER_MODE=auto
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=
S3_ACL=

# Meta Graph API — page token with pages_manage_posts and instagram_content_publish
META_PAGE_ID=
META_PAGE_ACCESS_TOKEN=
META_IG_USER_ID=

# Zernio social gateway. Each broker connects their own Facebook, Instagram and TikTok.
ZERNIO_API_KEY=
ZERNIO_BASE_URL=https://api.zernio.com
SOCIAL_GATEWAY_WEBHOOK_SECRET=

# TikTok Content Posting API
TIKTOK_ACCESS_TOKEN=
# Unaudited TikTok apps must stay on SELF_ONLY. After audit: PUBLIC_TO_EVERYONE
TIKTOK_PRIVACY_LEVEL=SELF_ONLY

# Optional first broker created by `npm run seed` or AUTO_SEED=true
AUTO_SEED=false
INITIAL_BROKER_PHONE=
INITIAL_BROKER_NAME=
INITIAL_BROKER_BUSINESS=
INITIAL_FB_GROUP_ID=
INITIAL_FB_GROUP_NAME=
