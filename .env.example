# Production / Railway: set DATABASE_URL to a PostgreSQL instance.
# Locally, leave it empty and `npm start` will boot an embedded PostgreSQL.

PORT=3000
NODE_ENV=development
DATABASE_URL=
PUBLIC_BASE_URL=http://localhost:3000
ADMIN_TOKEN=

# WhatsApp Cloud API (Meta)
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_DISPLAY_NUMBER=
META_APP_SECRET=
META_GRAPH_VERSION=v21.0
# Approved utility template with a single body variable, used only outside the 24h window.
WHATSAPP_BROKER_TEMPLATE_NAME=
WHATSAPP_BROKER_TEMPLATE_LANG=he

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Storage: local | cloudinary | s3
STORAGE_PROVIDER=local
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=
S3_ACL=

# Meta Graph API — page token with pages_manage_posts and instagram_content_publish
META_PAGE_ID=
META_PAGE_ACCESS_TOKEN=
META_IG_USER_ID=

# TikTok Content Posting API
TIKTOK_ACCESS_TOKEN=
# Unaudited TikTok apps must stay on SELF_ONLY. After audit: PUBLIC_TO_EVERYONE
TIKTOK_PRIVACY_LEVEL=SELF_ONLY

# Optional first broker created by `npm run seed` or AUTO_SEED=true
AUTO_SEED=false
INITIAL_BROKER_PHONE=
INITIAL_BROKER_NAME=
INITIAL_BROKER_BUSINESS=
INITIAL_FB_GROUP_ID=
INITIAL_FB_GROUP_NAME=
